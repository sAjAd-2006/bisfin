# Bisfin application environment. Copy to .env for local development only.
# Production secrets must come from a managed secret store, not this file.
BISFIN_ENV=local
BISFIN_LOG_LEVEL=INFO
# Supported values: console, json
BISFIN_LOG_FORMAT=console

# DATABASE_URL has precedence over the individual POSTGRES_* values when set.
# Both postgresql:// and postgresql+psycopg:// inputs are normalized to the
# synchronous SQLAlchemy psycopg dialect. Keep it commented to use the fields below.
# DATABASE_URL=postgresql+psycopg://bisfin:replace_me@127.0.0.1:55432/bisfin

# Safe local Docker Compose defaults. Do not reuse this password outside development.
COMPOSE_PROJECT_NAME=bisfin
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=bisfin
POSTGRES_USER=bisfin
POSTGRES_PASSWORD=bisfin_dev_only_password

# SQLAlchemy QueuePool and PostgreSQL session settings.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
# Applied per connection through PostgreSQL options; must be a positive integer.
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_APPLICATION_NAME=bisfin

# BrsApi unadjusted daily candles (TSETMC Candlestick type=2 only).
BRSAPI_BASE_URL=https://Api.BrsApi.ir/
# Fixture ingestion does not need a key. Set this only in ignored .env or a
# managed secret store for an explicitly requested live ingestion.
# BRSAPI_API_KEY=replace_with_your_secret
BRSAPI_CONNECT_TIMEOUT_SECONDS=5
BRSAPI_READ_TIMEOUT_SECONDS=30
BRSAPI_USER_AGENT=bisfin/0.1 brsapi-daily-bars
BRSAPI_PROVIDER_CODE=BRSAPI
BRSAPI_DAILY_RAW_FEED_CODE=TSETMC_CANDLE_DAILY_RAW
BRSAPI_SYMBOL_FEED_CODE=TSETMC_SYMBOL_METADATA
BRSAPI_IDENTIFIER_TYPE=BRSAPI_L18
BRSAPI_DEFAULT_TIMEZONE=Asia/Tehran
BISFIN_PROVIDER_CODE=BISFIN
BISFIN_CATALOG_FEED_CODE=BISFIN_CATALOG_MANIFEST
BISFIN_CALENDAR_FEED_CODE=BISFIN_TRADING_CALENDAR
# manifest-only (default), fixture-validate, or live-validate
CATALOG_DEFAULT_VALIDATION_MODE=manifest-only
